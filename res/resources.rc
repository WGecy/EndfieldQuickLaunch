// Resource script: application manifest (requireAdministrator) + version info.
// 1 = RT_MANIFEST, 24 = CREATEPROCESS_MANIFEST_RESOURCE_ID
1 24 "EndfieldQuickLaunch.manifest"

// 1 = VS_VERSION_INFO, 16 = RT_VERSION (Explorer file properties).
1 VERSIONINFO
FILEVERSION     1,2,1,0
PRODUCTVERSION  1,2,1,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L
FILETYPE        0x1L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription",  "Endfield Quick Launch\0"
            VALUE "FileVersion",      "1.2.1.0\0"
            VALUE "InternalName",     "EndfieldQuickLaunch\0"
            VALUE "OriginalFilename", "EndfieldQuickLaunch.exe\0"
            VALUE "ProductName",      "Endfield Quick Launch\0"
            VALUE "ProductVersion",   "1.2.1.0\0"
            VALUE "LegalCopyright",   "MIT License\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
